{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "npm install && npx playwright install chromium && (cp $T3CODE_PROJECT_ROOT/.dev.vars .dev.vars || true)",
      "icon": "configure",
      "runOnWorktreeCreate": true
    },
    {
      "name": "Dev Server",
      "command": "npm run dev -- --port \"$T3CODE_WORKSPACE_PORT\" --open",
      "icon": "debug"
    },
    {
      "name": "Test",
      "command": "npm run test:all",
      "icon": "test"
    },
    {
      "name": "Browser Tests",
      "command": "npm run test:e2e -- --ui --ui-port=$((T3CODE_WORKSPACE_PORT + 1))",
      "icon": "test"
    }
  ]
}
