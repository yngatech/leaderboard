{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leaderboard",
  "account_id": "c758a534d893ea05ed051851bacabeb7",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "preview_urls": true,
  "routes": [
    {
      "pattern": "leaderboard.ynga.tech",
      "custom_domain": true
    }
  ],
  "assets": {
    // No `directory`: the Vite plugin points it at the client build output.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API and the markdown views are handled by the Worker, never the asset router.
    "run_worker_first": ["/api/*", "/*.md"]
  },
  "observability": {
    "enabled": true
  }
}
