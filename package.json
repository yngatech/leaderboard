{
  "name": "ynga-git-board",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "npm run build && vite preview",
    "build": "npm run typecheck && vite build",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p functions/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "solid-js": "^1.9.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/workers-types": "^5.20260722.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-solid": "^2.11.6",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
